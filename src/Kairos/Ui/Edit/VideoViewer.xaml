<UserControl x:Class="Kairos.Ui.Edit.VideoViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui"
             Focusable="False">
    <!-- A clip in Kairos's own player over the window: play, seek, sound, edit, share, show, delete. Esc or a click outside closes. -->
    <Grid x:Name="Scrim" Background="#E01A1514" MouseLeftButtonDown="OnScrimClick">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="28,44,20,10" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Meta" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
            <Button x:Name="EditButton" Grid.Column="1" Style="{StaticResource Ghost}" Click="OnEdit" Padding="14,9" Margin="0,0,8,0"
                    AutomationProperties.Name="{l:T viewer.edit}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T viewer.edit}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Ghost}" Padding="11,9" Click="OnClose"
                    ToolTip="{l:T viewer.close}" AutomationProperties.Name="{l:T viewer.close}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13"/>
            </Button>
        </Grid>

        <!-- Never mirrored: a clip plays the same in Arabic -->
        <Border x:Name="Frame" Grid.Row="1" Margin="28,0" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1" Background="Black" MouseLeftButtonDown="OnVideoClick" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Grid FlowDirection="LeftToRight">
                <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{Binding Text, ElementName=Heading}"/>
                <!-- Shown while paused: where to click -->
                <Border x:Name="PlayMark" Width="64" Height="64" CornerRadius="32" Background="#99000000" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="24" Foreground="White" Margin="4,0,0,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Play, where it is, and the sound -->
        <Grid Grid.Row="2" Margin="28,14,28,0" MaxWidth="900" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Style="{StaticResource Ghost}" Padding="11,9" Click="OnPlay" VerticalAlignment="Center">
                <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xF5B0;" FontSize="13"/>
            </Button>
            <TextBlock x:Name="Time" Grid.Column="1" Style="{StaticResource Caption}" Margin="12,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
            <Slider x:Name="Seek" Grid.Column="2" VerticalAlignment="Center" Minimum="0" IsMoveToPointEnabled="True" FlowDirection="LeftToRight"
                    AutomationProperties.Name="{Binding Text, ElementName=Time}"
                    ValueChanged="OnSeekChanged" Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted"/>
            <Button x:Name="MuteButton" Grid.Column="3" Style="{StaticResource Ghost}" Padding="11,9" Margin="12,0,0,0" Click="OnMute" VerticalAlignment="Center">
                <TextBlock x:Name="MuteIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="13"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,24" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Primary}" Click="OnShare" Padding="18,9" Margin="0,0,8,0" AutomationProperties.Name="{l:T clips.share}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T clips.share}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Ghost}" Click="OnShow" Padding="16,9" Margin="0,0,8,0" AutomationProperties.Name="{l:T clips.show}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T clips.show}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Ghost}" Click="OnDelete" Padding="16,9" AutomationProperties.Name="{l:T clips.recycle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{l:T clips.recycle}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
