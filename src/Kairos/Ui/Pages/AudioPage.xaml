<UserControl x:Class="Kairos.Ui.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui"
             x:Name="Page">
    <UserControl.Resources>
        <!-- Mute: the speaker, crossed out (in the accent) while muted -->
        <Style x:Key="MuteButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE767;" HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE74F;"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="{l:T nav.audio}"/>

        <UniformGrid Columns="2" Margin="0,0,-12,12">
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="audioLayout" AutomationProperties.Name="{l:T audio.layoutSeparate}"
                         IsChecked="{Binding AudioLayout, Converter={StaticResource Eq}, ConverterParameter=Separate}"
                         IsEnabled="{Binding SeparateSourcesAvailable}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:T audio.layoutSeparate}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.layoutSeparateTip}"/>
                    </StackPanel>
                </Grid>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="audioLayout" AutomationProperties.Name="{l:T audio.layoutTogether}"
                         IsChecked="{Binding AudioLayout, Converter={StaticResource Eq}, ConverterParameter=Together}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:T audio.layoutTogether}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.layoutTogetherTip}"/>
                    </StackPanel>
                </Grid>
            </RadioButton>
        </UniformGrid>
        <!-- A Windows 10 before 2004: why Separate sources cannot be chosen -->
        <TextBlock Style="{StaticResource Caption}" Text="{Binding SeparateSourcesNote}" Foreground="{StaticResource Warning}" Margin="0,-4,0,12"
                   Visibility="{Binding SeparateSourcesNote, Converter={StaticResource Vis}}"/>

        <!-- Separate sources: a row per source -->
        <Border Style="{StaticResource Card}" Visibility="{Binding AudioSeparate, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.cardSources}"/>
                <ItemsControl ItemsSource="{Binding AudioRows}" AlternationCount="1000" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border x:Name="Line" Style="{StaticResource Divider}" Margin="0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- The remove button's room on every row, so the switches and mute buttons line up -->
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding State}" Margin="0" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,8,0" Background="Transparent"
                                                ToolTip="{Binding OwnTrackTip}" ToolTipService.ShowOnDisabled="True">
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.ownTrack}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   IsEnabled="{Binding CanOwnTrack}"/>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OwnTrack}" IsEnabled="{Binding CanOwnTrack}"
                                                  AutomationProperties.Name="{l:T audio.ownTrack}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="3" Style="{StaticResource MuteButton}" IsChecked="{Binding Muted}"
                                                  ToolTip="{l:T audio.mute}" AutomationProperties.Name="{l:T audio.mute}"/>
                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                            Visibility="{Binding Removable, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.RemoveAudioRowCommand, ElementName=Page}" CommandParameter="{Binding}"
                                            ToolTip="{l:T audio.remove}" AutomationProperties.Name="{l:T audio.remove}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="30,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <l:LevelBar Channel="{Binding Id}" VerticalAlignment="Center" AutomationProperties.Name="{l:T audio.level}"/>
                                    <Slider Grid.Column="2" Minimum="0" Maximum="200" Value="{Binding Volume}" IsSnapToTickEnabled="True" TickFrequency="5"
                                            VerticalAlignment="Center" AutomationProperties.Name="{l:T audio.volume}"/>
                                    <TextBlock Grid.Column="3" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="{Binding Volume, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="30,8,0,0" Visibility="{Binding IsGame, Converter={StaticResource Vis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="288"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.gameFollows}" Margin="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.GameFollowChoices, ElementName=Page}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Follows}" AutomationProperties.Name="{l:T audio.gameFollows}"/>
                                </Grid>
                                <StackPanel Margin="30,8,0,0" Visibility="{Binding IsMicrophone, Converter={StaticResource Vis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="288"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.device}" Margin="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Mics, ElementName=Page}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding DataContext.MicDevice, ElementName=Page}" AutomationProperties.Name="{l:T audio.device}"/>
                                    </Grid>
                                    <!-- A mixer's whole mix as the microphone: the other rows would be in it twice -->
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DataContext.MicDeviceWarning, ElementName=Page}" Foreground="{StaticResource Warning}"
                                               Margin="0,6,0,0" Visibility="{Binding DataContext.MicDeviceWarning, ElementName=Page, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                    <Setter TargetName="Line" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Divider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Padding="14,7" Click="OnAddSource" AutomationProperties.Name="{l:T audio.add}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T audio.add}" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- All PC sound together: 1.0.1's page as it was -->
        <StackPanel Visibility="{Binding AudioTogether, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Section}" Text="{l:T audio.system}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding AudioSystem}" AutomationProperties.Name="{l:T audio.system}"/>
                    </Grid>
                    <l:LevelBar Channel="system" Margin="30,12,0,0" Visibility="{Binding AudioSystem, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T audio.level}"/>
                    <StackPanel IsEnabled="{Binding AudioSystem}" Margin="30,14,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T audio.device}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Speakers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SystemDevice}" AutomationProperties.Name="{l:T audio.device}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SystemDeviceWarning}" Foreground="{StaticResource Warning}" Margin="0,-4,0,10"
                                   Visibility="{Binding SystemDeviceWarning, Converter={StaticResource Vis}}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="272"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T audio.volume}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding SystemVolume}" IsSnapToTickEnabled="True" TickFrequency="5"
                                    VerticalAlignment="Center" AutomationProperties.Name="{l:T audio.volume}"/>
                            <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding SystemVolume, Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Section}" Text="{l:T audio.mic}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Mic}" AutomationProperties.Name="{l:T audio.mic}"/>
                    </Grid>
                    <l:LevelBar Channel="mic" Margin="30,12,0,0" Visibility="{Binding Mic, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T audio.level}"/>
                    <StackPanel Margin="30,14,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T audio.device}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Mics}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding MicDevice}" AutomationProperties.Name="{l:T audio.device}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding MicDeviceWarning}" Foreground="{StaticResource Warning}" Margin="0,-4,0,10"
                                   Visibility="{Binding MicDeviceWarning, Converter={StaticResource Vis}}"/>
                        <Grid IsEnabled="{Binding Mic}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="272"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T audio.volume}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding MicVolume}" IsSnapToTickEnabled="True" TickFrequency="5"
                                    VerticalAlignment="Center" AutomationProperties.Name="{l:T audio.volume}"/>
                            <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding MicVolume, Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.cardOptions}"/>
                <StackPanel Visibility="{Binding AudioTogether, Converter={StaticResource Vis}}">
                    <Grid ToolTip="{l:T audio.separateTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Label}" Text="{l:T audio.separate}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.separateTip}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SeparateTracks}" AutomationProperties.Name="{l:T audio.separate}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <!-- Apps and Games only: the full screen has no app or game of its own to keep -->
                    <StackPanel Visibility="{Binding SourceAudioPossible, Converter={StaticResource Vis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T audio.sourceOnly}" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SourceAudioOnly}" AutomationProperties.Name="{l:T audio.sourceOnly}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T audio.bitrate}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AudioBitrates}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding AudioBitrate}" AutomationProperties.Name="{l:T audio.bitrate}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
