<UserControl x:Class="Kairos.Ui.Pages.ClipsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui">
    <UserControl.Resources>
        <!-- Cards inside an open folder, under day headings (Today, Yesterday…) -->
        <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <!-- Round button on a clip picture (same look as the selection check) -->
        <Style x:Key="ThumbAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="30" Height="30" CornerRadius="15" Background="#99000000" BorderBrush="#66FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A card's picture: all of it opens the clip (a video in Kairos's player, a screenshot in the viewer); the mark in the middle says so -->
        <Style x:Key="OpenCard" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/>
            <Setter Property="AutomationProperties.Name" Value="{l:T clips.play}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Mark" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Accent}" Opacity="0.82"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15" Foreground="{DynamicResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPicture}" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE722;"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPicture}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="{l:T clips.view}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Ghost}" Command="{Binding BackCommand}" Padding="10,7" Margin="0,0,10,0"
                        Visibility="{Binding InsideFolder, Converter={StaticResource Vis}}"
                        ToolTip="{l:T clips.back}" AutomationProperties.Name="{l:T clips.back}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T clips.back}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Title}" Text="{Binding FolderTitle}" Margin="0" VerticalAlignment="Center"
                           AutomationProperties.HelpText="{Binding CountText}"/>
                <TextBlock Text="{Binding SelectedSizeText}" FontSize="16" FontWeight="Normal" Foreground="{StaticResource TextSecondary}"
                           Margin="14,5,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <!-- Pink +: new folder, and unhide when albums are hidden -->
            <Button Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                    Click="OnAddFolderMenu" FocusVisualStyle="{StaticResource KeyFocus}"
                    Visibility="{Binding ShowFolderRow, Converter={StaticResource Vis}}"
                    ToolTip="{l:T clips.folder.new}" AutomationProperties.Name="{l:T clips.folder.new}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Add" Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource Accent}" SnapsToDevicePixels="True">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15"
                                       Foreground="{DynamicResource OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Add" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Add" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Add" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource Ghost}" Command="{Binding SelectAllCommand}" Padding="12,7" Margin="0,0,8,0" VerticalAlignment="Center"
                    Visibility="{Binding ShowClips, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectAllLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <ComboBox Grid.Column="4" Width="190" VerticalAlignment="Center" ItemsSource="{Binding Apps}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Filter}" Margin="0,0,8,0" AutomationProperties.Name="{l:T clips.all}"
                      Visibility="{Binding InsideFolder, Converter={StaticResource Vis}}"/>
            <Button Grid.Column="5" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Padding="11,9"
                    ToolTip="{l:T clips.refresh}" AutomationProperties.Name="{l:T clips.refresh}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
            </Button>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="28" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="34" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Confirm removing a user album (defaults cannot be deleted) -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14"
                Visibility="{Binding ConfirmingFolderDelete, Converter={StaticResource Vis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Ghost}" Content="{l:T clips.cancel}" Command="{Binding CancelDeleteFolderCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Primary}" Content="{l:T clips.folder.delete}" Command="{Binding ConfirmDeleteFolderCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding FolderDeleteText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

        <!-- Home: album cards. Defaults have no ⋮ (cannot delete/rename). New folder is the header +. -->
        <WrapPanel Margin="0,0,0,20" Visibility="{Binding ShowFolderRow, Converter={StaticResource Vis}}">
            <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:LibraryFolder}">
                        <Grid Width="200" Height="248" Margin="0,0,14,12">
                            <Button Cursor="Hand" FocusVisualStyle="{StaticResource KeyFocus}"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card" CornerRadius="16" ClipToBounds="True"
                                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="0"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- Cover -->
                                                <Grid Grid.Row="0" ClipToBounds="True" Background="#231D1C">
                                                    <Border Width="168" Height="100" Margin="0,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                            CornerRadius="10" Background="{StaticResource Stroke}" Opacity="0.55"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <RotateTransform Angle="-5"/>
                                                                <TranslateTransform X="-10" Y="2"/>
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                    <Border Width="168" Height="100" Margin="0,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                            CornerRadius="10" Background="{StaticResource StrokeStrong}" Opacity="0.4"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <RotateTransform Angle="4"/>
                                                                <TranslateTransform X="10" Y="4"/>
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                    <Border Width="176" Height="112" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                            CornerRadius="12" Background="#231D1C" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="28"
                                                                       Foreground="{StaticResource StrokeStrong}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Cover.Thumbnail}" Stretch="UniformToFill"
                                                                   FlowDirection="LeftToRight"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0"
                                                            Padding="8,5" CornerRadius="9" Background="{DynamicResource AccentSoft}"
                                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="11"
                                                                       Foreground="{DynamicResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Meta}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <!-- Banner footer: name + size + modified (off the cover) -->
                                                <Border Grid.Row="1" Background="{StaticResource Bg}" Padding="14,10,14,12"
                                                        BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SizeText}" FontSize="12" Margin="0,5,0,0"
                                                                   Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{l:T clips.folder.modified}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding ModifiedText}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}"/>
                                                <Setter TargetName="Card" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="-3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- ⋮ only on user albums — defaults cannot be renamed or deleted -->
                            <Button Style="{StaticResource ThumbAction}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,10,0" Padding="0" Click="OnFolderMenu"
                                    Visibility="{Binding IsDefault, Converter={StaticResource Vis}, ConverterParameter=invert}"
                                    ToolTip="{l:T clips.folder.options}" AutomationProperties.Name="{l:T clips.folder.options}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="13" Foreground="White"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <Border Style="{StaticResource Card}" Padding="28" Visibility="{Binding FolderEmpty, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Home: Recent (last 5). Inside a folder: Recent then older by day. Room for the selection bar. -->
        <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" Margin="-6,0,-6,64"
                      Visibility="{Binding ShowClips, Converter={StaticResource Vis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="8,10,8,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Section}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type l:ClipItem}">
                    <Border x:Name="Card" Width="250" Margin="6" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1.5" CornerRadius="12">
                        <StackPanel>
                            <Border CornerRadius="11,11,0,0" Height="140" Background="#231D1C" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="28" Foreground="{StaticResource StrokeStrong}" HorizontalAlignment="Center"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" FlowDirection="LeftToRight"/>
                                    <!-- Opens the clip; dragged, it goes out as a file (into Discord, a chat, a folder) -->
                                    <Button Style="{StaticResource OpenCard}" CommandParameter="{Binding}" Initialized="OnCardInitialized"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <!-- An HEVC clip's H.264 copy being made for a drag: drag again once it is done -->
                                    <Grid Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Visibility="{Binding Preparing, Converter={StaticResource Vis}}">
                                        <Ellipse Fill="#EE231D1C"/>
                                        <l:ProgressRing Value="{Binding PrepareProgress}" Thickness="3.5" Fill="{DynamicResource Accent}" Track="{StaticResource Stroke}"/>
                                        <TextBlock Text="{Binding PreparePercent}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                    </Grid>
                                    <CheckBox Style="{StaticResource SelectCheck}" IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Margin="10" AutomationProperties.Name="{Binding Name}"/>
                                    <!-- Pin / unpin: favorites stay on top under the glass folder -->
                                    <Button x:Name="FavBtn" Style="{StaticResource ThumbAction}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,8,0,0"
                                            Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{l:T clips.favorite}" AutomationProperties.Name="{l:T clips.favorite}">
                                        <TextBlock x:Name="FavGlyph" Style="{StaticResource Icon}" Text="&#xE734;" FontSize="13" Foreground="White"/>
                                    </Button>
                                    <!-- Kind mark: video camera or photo, so mixed lists still read at a glance -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="6,4" CornerRadius="8"
                                            Background="#99000000" BorderBrush="#66FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Viewbox x:Name="VideoBadge" Width="12" Height="12">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M4,6 H14 A2,2 0 0 1 16,8 V16 A2,2 0 0 1 14,18 H4 A2,2 0 0 1 2,16 V8 A2,2 0 0 1 4,6 Z
                                                                M16,10.5 L21.25,7.44 A0.5,0.5 0 0 1 22,7.87 V16.13 A0.5,0.5 0 0 1 21.25,16.56 L16,13.5 Z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox x:Name="PhotoBadge" Width="12" Height="12" Visibility="Collapsed">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z
                                                                M3,16 L7,13 L10,15 L16,10 L21,14"/>
                                                    <Ellipse Canvas.Left="6" Canvas.Top="8" Width="3" Height="3" Fill="White"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <!-- Share straight from the card (a quick post), over the picture's own button -->
                                    <Button Style="{StaticResource ThumbAction}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                            Command="{Binding DataContext.ShareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{l:T clips.share}" AutomationProperties.Name="{l:T clips.share}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid Margin="14,10,10,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                        <!-- The column is about 150 wide: the name gives the "New" mark room only while it shows -->
                                        <TextBlock Text="{Binding App}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="MaxWidth" Value="150"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="MaxWidth" Value="104"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Saved while this page was open -->
                                        <Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="6,0,6,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{l:T clips.new}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <!-- The clip's own camera file: a camera mark that opens it -->
                                <Button Grid.Column="1" Style="{StaticResource Ghost}" Padding="8,6" Margin="4,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenCameraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding Camera, Converter={StaticResource Vis}}"
                                        ToolTip="{l:T clips.openCamera}" AutomationProperties.Name="{l:T clips.openCamera}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource Ghost}" Padding="8,6" Margin="4,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{l:T clips.show}" AutomationProperties.Name="{l:T clips.show}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource Ghost}" Padding="8,6" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{l:T clips.recycle}" AutomationProperties.Name="{l:T clips.recycle}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource Accent}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPicture}" Value="True">
                            <Setter TargetName="VideoBadge" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PhotoBadge" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter TargetName="FavGlyph" Property="Text" Value="&#xE735;"/>
                            <Setter TargetName="FavGlyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="FavBtn" Property="ToolTip" Value="{l:T clips.unfavorite}"/>
                            <Setter TargetName="FavBtn" Property="AutomationProperties.Name" Value="{l:T clips.unfavorite}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
