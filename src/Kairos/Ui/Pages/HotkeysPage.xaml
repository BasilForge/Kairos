<UserControl x:Class="Kairos.Ui.Pages.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui">
    <UserControl.Resources>
        <Style x:Key="HkBox" TargetType="l:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{l:T hotkeys.hint}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="{l:T nav.hotkeys}"/>

        <!-- One card per feature -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T hotkeys.cardReplay}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T hotkeys.save}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <l:HotkeyBox Grid.Column="1" Style="{StaticResource HkBox}" Hotkey="{Binding HkSave}" AutomationProperties.Name="{l:T hotkeys.save}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid Margin="0,2" IsEnabled="{Binding QuickEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T hotkeys.quick}" VerticalAlignment="Center"/>
                    <l:HotkeyBox Grid.Column="1" Style="{StaticResource HkBox}" Hotkey="{Binding HkQuick}" AutomationProperties.Name="{l:T hotkeys.quick}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T hotkeys.toggle}" VerticalAlignment="Center"/>
                    <l:HotkeyBox Grid.Column="1" Style="{StaticResource HkBox}" Hotkey="{Binding HkToggle}" AutomationProperties.Name="{l:T hotkeys.toggle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T hotkeys.cardRecording}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T hotkeys.record}" VerticalAlignment="Center"/>
                    <l:HotkeyBox Grid.Column="1" Style="{StaticResource HkBox}" Hotkey="{Binding HkRecord}" AutomationProperties.Name="{l:T hotkeys.record}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T hotkeys.pauseRecord}" VerticalAlignment="Center"/>
                    <l:HotkeyBox Grid.Column="1" Style="{StaticResource HkBox}" Hotkey="{Binding HkPauseRecord}" AutomationProperties.Name="{l:T hotkeys.pauseRecord}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T hotkeys.cardScreenshot}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T hotkeys.screenshot}" VerticalAlignment="Center"/>
                    <l:HotkeyBox Grid.Column="1" Style="{StaticResource HkBox}" Hotkey="{Binding HkScreenshot}" AutomationProperties.Name="{l:T hotkeys.screenshot}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Back to Kairos's own keys (saved with the rest, so Revert still undoes it) -->
        <Button Style="{StaticResource Ghost}" Command="{Binding ResetHotkeysCommand}" HorizontalAlignment="Left" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T hotkeys.reset}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
