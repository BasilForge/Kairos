<UserControl x:Class="Kairos.Ui.ShareOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui"
             Focusable="False">
    <UserControl.Resources>
        <!-- Compact platform tile: same selection language as the choice cards, sized for four in a row. -->
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1.5"
                                CornerRadius="10" Padding="6,12,6,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Copy: a tile that acts at once (no choice to keep), same look as the platform tiles -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1.5"
                                CornerRadius="10" Padding="6,12,6,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One emoji in the caption picker -->
        <Style x:Key="EmojiButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Platform marks: the round logos supplied by the project owner, all the same size, never mirrored. -->
        <Style x:Key="Badge" TargetType="Image">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
        <Style x:Key="TileName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Scrim" Background="#C81A1514">
        <Border x:Name="Panel" MaxWidth="940" Margin="24,52,24,24" VerticalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="14"
                WindowChrome.IsHitTestVisibleInChrome="True" KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="{l:T share.title}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Margin="24,16,14,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="9,8" Command="{Binding CloseCommand}"
                            ToolTip="{l:T share.close}" AutomationProperties.Name="{l:T share.close}" BorderBrush="Transparent">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="11"/>
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="17" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="24,16,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="11*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="10*"/>
                        </Grid.ColumnDefinitions>

                        <!-- The clip: picture (with the 9:16 frame), playback and trim, and (when ready) the file to drag -->
                        <StackPanel VerticalAlignment="Top">
                            <l:AspectBox Ratio="{Binding PreviewAspect}">
                                <!-- A click on the picture plays or pauses the cut; with 9:16 on, a drag moves the frame -->
                                <Border x:Name="Preview" CornerRadius="10" Background="#231D1C" ClipToBounds="True" Cursor="Hand"
                                        FlowDirection="LeftToRight" MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" MouseLeftButtonUp="OnPreviewUp"
                                        ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="28" Foreground="{StaticResource StrokeStrong}" HorizontalAlignment="Center"/>
                                        <Image Source="{Binding PreviewFrame}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- 9:16 frame: drag it sideways on the picture -->
                                        <Grid Visibility="{Binding ShowCrop, Converter={StaticResource Vis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding CropLeft}"/>
                                                <ColumnDefinition Width="{Binding CropWindow}"/>
                                                <ColumnDefinition Width="{Binding CropRight}"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="#B4000000"/>
                                            <Border x:Name="CropWindow" Grid.Column="1" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="3"
                                                    Background="Transparent" Cursor="SizeWE" ToolTip="{l:T share.verticalTip}">
                                                <TextBlock Text="9:16" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="6,4" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                            </Border>
                                            <Rectangle Grid.Column="2" Fill="#B4000000"/>
                                        </Grid>
                                        <!-- Edit (top right, like the player) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="9" Background="#B0141010"
                                                Visibility="{Binding IsChoosing, Converter={StaticResource Vis}}">
                                            <Button x:Name="EditButton" Style="{StaticResource Ghost}" Command="{Binding EditCommand}" Padding="12,7" FontSize="13"
                                                    BorderBrush="Transparent" Foreground="White" AutomationProperties.Name="{l:T viewer.edit}">
                                                <StackPanel Orientation="Horizontal" FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="White"/>
                                                    <TextBlock Text="{l:T viewer.edit}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <!-- Paused: a round play mark in the middle (the click goes to the picture) -->
                                        <Border Width="60" Height="60" CornerRadius="30" Background="#99000000" IsHitTestVisible="False"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding ShowPlayMark, Converter={StaticResource Vis}}">
                                            <Path Data="M 0,0 L 18,11 L 0,22 Z" Fill="White" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- The preview's loudness, in the corner like any player, while the pointer is on the picture.
                                             Only what is heard here: the shared clip keeps its own sound. Its clicks never play or move the frame. -->
                                        <Border x:Name="VolumePill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" CornerRadius="16"
                                                Background="#A6000000" Padding="3,2,12,2" Cursor="Arrow" Opacity="0"
                                                ToolTip="{l:T share.previewVolume}" MouseWheel="OnVolumeWheel"
                                                Visibility="{Binding CanPlay, Converter={StaticResource Vis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMouseOver, ElementName=Preview}" Value="False"/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource EmojiButton}" Command="{Binding MuteCommand}" Padding="5" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{l:T share.mute}">
                                                    <TextBlock FontSize="16" Width="20" TextAlignment="Center" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                <Setter Property="Text" Value="&#xE767;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE74F;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding PreviewVolume}" SmallChange="0.05" LargeChange="0.2"
                                                        IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="2,0,0,0"
                                                        AutomationProperties.Name="{l:T share.previewVolume}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </l:AspectBox>

                            <!-- Trim, left to right like the picture whatever the language, and one short line under it -->
                            <l:TrimBar Margin="0,10,0,0" IsEnabled="{Binding CanEdit}" Visibility="{Binding HasVideo, Converter={StaticResource Vis}}"
                                       Duration="{Binding ClipSeconds}" Start="{Binding TrimStart}" End="{Binding TrimEnd}" MoveStart="{Binding TrimMoveStart}"
                                       Playhead="{Binding Playhead}" ShowPlayhead="{Binding ShowPlayhead}" IsScrubbing="{Binding Scrubbing}"
                                       Frames="{Binding Filmstrip}" AutomationProperties.Name="{l:T share.trim}"/>
                            <!-- One line under the bar: where the cut starts and ends, and about how big it comes out -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" FlowDirection="LeftToRight"
                                        Visibility="{Binding HasVideo, Converter={StaticResource Vis}}">
                                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="10,4">
                                    <TextBlock Text="{Binding TrimRange}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Border>
                                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="10,4"
                                        Margin="8,0,0,0" Visibility="{Binding SizeEstimate, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding SizeEstimate}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Choices -->
                        <StackPanel Grid.Column="2" IsEnabled="{Binding CanEdit}" Visibility="{Binding HasClip, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Field}" Text="{l:T share.where}" Margin="0,0,0,8"/>
                            <UniformGrid Rows="1" Columns="4" Margin="0,0,-8,0">
                                <RadioButton Style="{StaticResource Tile}" GroupName="platform" AutomationProperties.Name="X"
                                             IsChecked="{Binding Platform, Converter={StaticResource Eq}, ConverterParameter=X}">
                                    <StackPanel>
                                        <Image Style="{StaticResource Badge}" Source="Assets/x.png"/>
                                        <TextBlock Style="{StaticResource TileName}" Text="X"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tile}" GroupName="platform" AutomationProperties.Name="TikTok"
                                             IsChecked="{Binding Platform, Converter={StaticResource Eq}, ConverterParameter=TikTok}">
                                    <StackPanel>
                                        <Image Style="{StaticResource Badge}" Source="Assets/tiktok.png"/>
                                        <TextBlock Style="{StaticResource TileName}" Text="TikTok"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tile}" GroupName="platform" AutomationProperties.Name="Instagram"
                                             IsChecked="{Binding Platform, Converter={StaticResource Eq}, ConverterParameter=Instagram}">
                                    <StackPanel>
                                        <Image Style="{StaticResource Badge}" Source="Assets/instagram.png"/>
                                        <TextBlock Style="{StaticResource TileName}" Text="Instagram"/>
                                    </StackPanel>
                                </RadioButton>
                                <!-- Copy: pressed, a video's sizes show under it (Original or Discord's) and the one picked goes on the
                                     clipboard; a check shows for a moment, a ring while it converts (pressed again: stops) -->
                                <Button x:Name="CopyTile" Style="{StaticResource ActionTile}" Command="{Binding CopyCommand}"
                                        AutomationProperties.Name="{l:T share.copy}" ToolTip="{l:T share.copyTip}">
                                    <StackPanel>
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                            <!-- Round like the logos beside it -->
                                            <Border CornerRadius="19">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource StrokeStrong}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCopyConverting}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="Text" Value="&#xE8C8;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <l:ProgressRing Value="{Binding CopyProgress}" Thickness="3.5" Fill="{DynamicResource Accent}" Track="{StaticResource Stroke}"
                                                            Visibility="{Binding IsCopyConverting, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding CopyPercent}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FlowDirection="LeftToRight" Visibility="{Binding IsCopyConverting, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TileName}">
                                                    <Setter Property="Text" Value="{l:T share.copy}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                            <Setter Property="Text" Value="{l:T share.copied}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCopyConverting}" Value="True">
                                                            <Setter Property="Text" Value="{l:T share.cancel}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <!-- The cut is longer than any picture fits in Copy's size: shorten it here -->
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding CopyTooLong, Converter={StaticResource Vis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="10,5" FontSize="12.5"
                                        Command="{Binding TrimToFitCommand}" Content="{l:T share.trimToFit}"/>
                                <TextBlock Text="{Binding CopyTooLong}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            </DockPanel>

                            <!-- Everywhere: X, TikTok and Instagram with one caption, one press -->
                            <RadioButton Style="{StaticResource Tile}" GroupName="platform" Margin="0,8,0,0" AutomationProperties.Name="{l:T share.all}"
                                         IsChecked="{Binding Platform, Converter={StaticResource Eq}, ConverterParameter=All}">
                                <StackPanel Orientation="Horizontal" Margin="0,-4">
                                    <!-- The three marks overlapping, left to right in every language -->
                                    <Grid Width="78" Height="34" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                        <Ellipse Width="36" Height="36" Fill="{StaticResource Bg}" HorizontalAlignment="Left" Margin="42,-1,0,-1"/>
                                        <Image Source="Assets/instagram.png" Width="32" Height="32" HorizontalAlignment="Left" Margin="44,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Ellipse Width="36" Height="36" Fill="{StaticResource Bg}" HorizontalAlignment="Left" Margin="20,-1,0,-1"/>
                                        <Image Source="Assets/tiktok.png" Width="32" Height="32" HorizontalAlignment="Left" Margin="22,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Ellipse Width="36" Height="36" Fill="{StaticResource Bg}" HorizontalAlignment="Left" Margin="-2,-1,0,-1"/>
                                        <Image Source="Assets/x.png" Width="32" Height="32" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <TextBlock Text="{l:T share.all}" FontSize="13.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Vertical 9:16, for every platform (off until turned on) -->
                            <DockPanel Margin="0,18,0,0" ToolTip="{l:T share.verticalTip}" Visibility="{Binding ShowVertical, Converter={StaticResource Vis}}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Vertical}"
                                          AutomationProperties.Name="{l:T share.vertical}"/>
                                <TextBlock Style="{StaticResource Label}" Text="{l:T share.vertical}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Visibility="{Binding ShowCaption, Converter={StaticResource Vis}}">
                                <TextBlock Style="{StaticResource Field}" Text="{l:T share.caption}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- One field: the text, and the emoji button inside its frame at the end -->
                                    <Border CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource FieldFill}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <!-- Emoji: a colour picker of popular ones, and Windows' own panel for the rest -->
                                            <Button x:Name="EmojiButton" DockPanel.Dock="Right" Style="{StaticResource EmojiButton}" Padding="3" Margin="0,2,4,2" VerticalAlignment="Center"
                                                    Click="OnEmojiOpen" ToolTip="{l:T share.emoji}" AutomationProperties.Name="{l:T share.emoji}">
                                                <!-- A plain smiley like the other icons; the colour ones are inside -->
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE76E;" FontSize="17" Width="20" TextAlignment="Center"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </Button>
                                            <TextBox x:Name="CaptionBox" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxHeight="76" FlowDirection="{Binding CaptionFlow}"
                                                     Padding="11,6,4,6" MinHeight="0" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="{l:T share.caption}">
                                                <!-- Just the text: the frame around it is the field -->
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <!-- Scrolls with the caret and the wheel, no bar (the theme's scroller adds its own room) -->
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                                            <ScrollViewer.Template>
                                                                <ControlTemplate TargetType="ScrollViewer">
                                                                    <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                                                </ControlTemplate>
                                                            </ScrollViewer.Template>
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                        </DockPanel>
                                    </Border>
                                    <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnEmojiClosed">
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="12"
                                                Padding="8" Margin="0,6,12,12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                                            </Border.Effect>
                                            <StackPanel FlowDirection="LeftToRight">
                                                <!-- Tabs: popular first, then faces, hands, games, symbols, nature -->
                                                <ListBox x:Name="EmojiTabs" ItemsSource="{x:Static l:EmojiPicks.Categories}" SelectedIndex="0"
                                                         Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,6"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="8" Padding="6,5" Margin="1,0">
                                                                                <Image Source="{Binding Icon.Source}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            </Border>
                                                                            <Rectangle x:Name="Bar" Height="2.5" RadiusX="1.2" RadiusY="1.2" VerticalAlignment="Bottom" Margin="10,0,10,-3"
                                                                                       Fill="{DynamicResource Accent}" Visibility="Hidden"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                                <Border Height="1" Background="{StaticResource Stroke}" Margin="2,0,2,6"/>
                                                <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                    <ItemsControl ItemsSource="{Binding SelectedItem.Emoji, ElementName=EmojiTabs}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="8"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource EmojiButton}" Click="OnEmojiPick" ToolTip="{Binding Emoji}"
                                                                        AutomationProperties.Name="{Binding Emoji}">
                                                                    <Image Source="{Binding Source}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Command="{Binding CopyCaptionCommand}" Margin="8,0,0,0" Padding="12,8"
                                            VerticalAlignment="Top" ToolTip="{l:T share.copyCaption}" AutomationProperties.Name="{l:T share.copyCaption}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding CopiedVisible, Converter={StaticResource Vis}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Success}" Margin="0,0,6,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T share.copied}" Foreground="{StaticResource Success}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer: plan and action / progress / result / error -->
                <Border Grid.Row="2" Background="{StaticResource NavBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14" Padding="24,14">
                    <Grid>
                        <DockPanel Visibility="{Binding IsChoosing, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding PrepareCommand}" MinWidth="150">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PrepareLabel}"/>
                                </StackPanel>
                            </Button>
                            <Border/>
                        </DockPanel>

                        <!-- Everywhere: a row per site, while it goes and after -->
                        <DockPanel Visibility="{Binding IsMulti, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T share.cancel}" Command="{Binding CancelCommand}" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding IsMultiRunning, Converter={StaticResource Vis}}"/>
                            <ItemsControl ItemsSource="{Binding Jobs}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10"
                                                Padding="10,8" Margin="0,0,8,0" ToolTip="{Binding Detail}">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding Logo}" Width="28" Height="28" FlowDirection="LeftToRight"
                                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="10,5" Content="{Binding OpenLabel}"
                                                        Command="{Binding OpenCommand}" VerticalAlignment="Center"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource Vis}}"/>
                                                <StackPanel Margin="10,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource StrokeStrong}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding NeedsUser}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" Margin="0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <DockPanel Visibility="{Binding IsSingleWorking, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T share.cancel}" Command="{Binding CancelCommand}" Margin="16,0,0,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{DynamicResource Accent}"
                                             Background="{StaticResource Bg}" BorderThickness="0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Kairos is posting through the site's page, off screen -->
                        <DockPanel Visibility="{Binding IsSinglePublishing, Converter={StaticResource Vis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{l:T share.cancel}" Command="{Binding CancelCommand}" Margin="16,0,0,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PublishText}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <ProgressBar Height="6" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{StaticResource Bg}" BorderThickness="0"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Visibility="{Binding IsSingleDone, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource SuccessSoft}" VerticalAlignment="Top" Margin="0,2,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ResultHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Ghost}" Command="{Binding ShowFileCommand}" Padding="11,9" Margin="0,0,8,0"
                                        ToolTip="{l:T share.showFile}" AutomationProperties.Name="{l:T share.showFile}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Command="{Binding CopyFileCommand}" Padding="11,9" Margin="0,0,8,0"
                                        ToolTip="{l:T share.copyFile}" AutomationProperties.Name="{l:T share.copyFile}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource Primary}" Command="{Binding OpenAgainCommand}" Margin="0"
                                        Visibility="{Binding ShowOpenAgain, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding OpenAgainLabel}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsFailed, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource WarningSoft}" VerticalAlignment="Top" Margin="0,2,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:T share.failed}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ErrorDetail}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="{Binding RetryLabel}" Command="{Binding RetryCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
