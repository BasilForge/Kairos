<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Kairos.Ui">

    <!-- Tokens -->
    <SolidColorBrush x:Key="Bg" Color="#2E2726"/>
    <SolidColorBrush x:Key="NavBg" Color="#282120"/>
    <SolidColorBrush x:Key="Surface" Color="#3A3130"/>
    <SolidColorBrush x:Key="CardHover" Color="#443A39"/>
    <SolidColorBrush x:Key="Stroke" Color="#4E4241"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#625453"/>
    <!-- The outline of a control (field, outlined button): 3:1 against the cards, so it reads as something to press or fill -->
    <SolidColorBrush x:Key="ControlStroke" Color="#8A7875"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F5ECEA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#BBAAA7"/>
    <SolidColorBrush x:Key="Accent" Color="#F48BA4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#F69CB2"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#483436"/>
    <SolidColorBrush x:Key="OnAccent" Color="#221C1B"/>
    <SolidColorBrush x:Key="Success" Color="#2ED47A"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#2F3A2E"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB020"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#41352A"/>
    <SolidColorBrush x:Key="Idle" Color="#AD9C99"/>
    <SolidColorBrush x:Key="IdleSoft" Color="#413736"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <l:EqualsConverter x:Key="Eq"/>
    <l:BoolToVisibilityConverter x:Key="Vis"/>
    <l:EqualsToVisibilityConverter x:Key="EqVis"/>

    <!-- Text -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,18"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,22"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- A card's own title, so a group of settings says what it is about -->
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Section}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- A heading between groups of pages in the side bar -->
    <Style x:Key="NavGroup" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="12,14,12,4"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Stroke}"/>
        <Setter Property="Margin" Value="0,14"/>
    </Style>

    <!-- Navigation item -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Ic" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Margin="0,0,12,0"/>
                            <!-- Tag "HD": a small outlined badge in the icon's place and colour (no such glyph in the icon font) -->
                            <Border x:Name="Badge" Width="18" Height="13" CornerRadius="3" BorderThickness="1.4" Margin="-1,0,11,0"
                                    BorderBrush="{Binding Foreground, ElementName=Ic}" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="HD" FontSize="8" FontWeight="Bold" Foreground="{Binding Foreground, ElementName=Ic}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" FlowDirection="LeftToRight"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="HD">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A rose ring around a control reached with the keyboard (Tab); WPF draws it for keyboard focus only -->
    <Style x:Key="KeyFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KeyFocusRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-2" StrokeThickness="1.5" Stroke="{DynamicResource Accent}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big selectable card (capture mode, codec) -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1.5"
                            CornerRadius="12" Padding="18,16">
                        <Grid>
                            <!-- Room for the check so long content (AV1 + "Recommended") never runs under it. -->
                            <ContentPresenter Margin="0,0,30,0"/>
                            <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="8" Padding="14,8" MinWidth="64">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two-sided pill (the replay's place): the sides inside one rounded track -->
    <Style x:Key="PillSide" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="0,6" MinWidth="104">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="{StaticResource Bg}"
                            BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1.5">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnAccent}"/>
                            <Setter TargetName="Thumb" Property="Width" Value="14"/>
                            <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="8" Padding="18,10" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource ControlStroke}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16,9"/>
    </Style>

    <!-- A small text button under a label (Caption size, in the accent colour): a step to take elsewhere -->
    <Style x:Key="Link" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Words" Style="{StaticResource Caption}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Words" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Words" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square button with an icon -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Round selection check on clip cards -->
    <Style x:Key="SelectCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12" Background="#99000000" BorderBrush="#CCFFFFFF" BorderThickness="1.5">
                        <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fields: the same inset look as the segmented buttons (dark fill, hairline border, 8 px corners). -->
    <SolidColorBrush x:Key="FieldFill" Color="#2A2322"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#302827"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#2A2322"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#625453"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#302827"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A2322"/>
    <!-- Disabled fields sink into the card instead of standing out lighter than active ones. -->
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#3A3130"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#4E4241"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#3A3130"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#4E4241"/>
    <!-- Pop-ups (drop-down lists, right-click menus, tooltips) on the cards' warm brown, not Fluent's grey #2C2C2C. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#3A3130"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#4E4241"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#4A3F3E"/>
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#3A3130"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#4E4241"/>
    <SolidColorBrush x:Key="FlyoutBackground" Color="#3A3130"/>
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#4E4241"/>
    <SolidColorBrush x:Key="ToolTipBackground" Color="#3A3130"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#4E4241"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
    </Style>
    <Style TargetType="l:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>
</ResourceDictionary>
