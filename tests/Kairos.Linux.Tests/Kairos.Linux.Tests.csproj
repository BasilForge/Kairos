<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows test project's harness and its tests that do not need WPF, run against Kairos.Linux. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>Kairos.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WinTests>$(MSBuildThisFileDirectory)..\Kairos.Tests\</WinTests>
  </PropertyGroup>

  <ItemGroup>
        <!-- Tests of code that is the same on both platforms -->
    <Compile Include="$(WinTests)VoiceModelTests.cs;$(WinTests)VoiceRoutingTests.cs;$(WinTests)VoiceTriggerTests.cs;$(WinTests)VoiceUnitTests.cs" />
    <Compile Include="$(WinTests)HotkeyTests.cs;$(WinTests)EncoderCatalogTests.cs;$(WinTests)EncoderPresetTests.cs" />
    <Compile Include="$(WinTests)BufferBudgetTests.cs;$(WinTests)ResolutionTests.cs;$(WinTests)VideoMathTests.cs;$(WinTests)SaveWatchTests.cs" />
    <Compile Include="$(WinTests)ClipTests.cs;$(WinTests)SettingsTests.cs;$(WinTests)LanguageTests.cs" />
    <Compile Include="$(WinTests)MeterBallisticsTests.cs;$(WinTests)UpdateRulesTests.cs;$(WinTests)VersionTests.cs;$(WinTests)NoteLengthTests.cs" />
    <Compile Include="$(WinTests)SharePlannerTests.cs;$(WinTests)SoundTempoTests.cs;$(WinTests)EditProjectTests.cs;$(WinTests)EditGraphTests.cs" />
    <Compile Include="$(WinTests)EditExportTests.cs;$(WinTests)ClipCutterTests.cs;$(WinTests)FrameGrabberTests.cs;$(WinTests)ClipDeleteTests.cs;$(WinTests)ShareSettingsTests.cs;$(WinTests)InstallChoicesTests.cs" />
    <Compile Include="*.cs" />
    <None Include="$(WinTests)Fixtures\**\*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kairos.Linux\Kairos.Linux.csproj" />
  </ItemGroup>

</Project>
